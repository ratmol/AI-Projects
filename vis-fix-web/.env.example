# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional. Without it the app still works, but skips web search.
# Get one at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional overrides (defaults shown)
# VISFIX_MODEL=google/gemini-3-flash-preview
# VISFIX_RATE_LIMIT=5/15 minutes
