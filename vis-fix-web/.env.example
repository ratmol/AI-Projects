# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional. Without it the app still works, but skips web search.
# Get one at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional overrides (defaults shown). Both models must accept image input.
# The defaults are free, vision-capable models from two providers, so OpenRouter
# falls back to the second when the first is rate limited. Confirm the exact
# slugs at https://openrouter.ai/models, since free model IDs change.
# VISFIX_MODEL=google/gemma-4-26b-a4b-it:free
# VISFIX_FALLBACK_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# VISFIX_RATE_LIMIT=5/15 minutes
