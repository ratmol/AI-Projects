# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional. Without it the app still works, but skips web search.
# Get one at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional. Comma-separated model chain, primary first. Every model must accept
# image input. The defaults are three free, vision-capable models; OpenRouter
# falls back down the list when one errors or is rate limited, and if all are
# exhausted the request fails cleanly rather than routing to a paid model.
# Confirm the exact slugs at https://openrouter.ai/models, since free IDs change.
# VISFIX_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-12b-v2-vl:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Optional.
# VISFIX_RATE_LIMIT=5/15 minutes
